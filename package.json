{
  "name": "agent-benchmarks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "tsc -p tsconfig.tests.json && node --test .local/testbuild/tests/*.test.js",
    "test:browser": "tsc -p tsconfig.tests.json && playwright test",
    "test:docker": "node tests/docker-smoke.mjs",
    "check": "npm run build && npm test",
    "admin:password": "node dist/scripts/password.js",
    "agent": "node dist/scripts/agent.js",
    "seed:demo": "node dist/scripts/seed.js",
    "backup": "node dist/scripts/backup.js",
    "restore": "node dist/scripts/restore.js",
    "connector": "node dist/scripts/connector.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tabler/icons-react": "^3.48.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "yauzl": "^3.4.0"
  }
}
