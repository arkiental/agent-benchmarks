# The only allowed browser origin. Use the final HTTPS URL before exposing it.
PUBLIC_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
SITE_NAME=Agent Benchmarks
# Leave blank to disable administration. Run npm run admin:password privately.
ADMIN_PASSWORD_HASH=
SESSION_HOURS=12
# Comma-separated exact proxy IPs or private CIDRs. Blank means forwarded headers are ignored.
TRUSTED_PROXY_CIDRS=
UPLOAD_MAX_MB=12
VIDEO_MAX_MB=100
STORAGE_MAX_MB=2048
# Allow indexing only after reviewing all published material.
ALLOW_INDEXING=false
